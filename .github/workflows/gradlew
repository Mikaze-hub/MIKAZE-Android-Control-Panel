#!/bin/bash
# gradlew - Gradle Wrapper Script untuk Linux/Mac

# Versi Gradle
GRADLE_VERSION="8.5"
GRADLE_SHA256="e92b2badbe96ca0e21d5c5e93076c1227f72ac6cd7f4f06a8f2b1eaa1dd59daa"

# Download jika belum ada
if [ ! -f "gradle/wrapper/gradle-${GRADLE_VERSION}-bin.zip" ]; then
    mkdir -p gradle/wrapper
    curl -fsSL -o "gradle/wrapper/gradle-${GRADLE_VERSION}-bin.zip" "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
fi

# Jalankan gradle
exec gradle "$@"
