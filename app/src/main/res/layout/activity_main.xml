<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050609"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/deviceCard"
            android:layout_width="360dp"
            android:layout_height="720dp"
            android:layout_marginEnd="40dp"
            app:cardCornerRadius="36dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#050609">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#050609"
                android:padding="12dp">

                <!-- Outer Frame with Glow -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/frame_outer_glow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Inner Frame -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/phone_frame_premium"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Screen Content -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="14dp"
                    android:background="#030507"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Status Bar -->
                <TextView
                    android:id="@+id/clockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginStart="22dp"
                    android:text="22:37"
                    android:textColor="#F8F9FA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:id="@+id/topStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginEnd="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <View
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:background="#FFD400"
                        android:alpha="0.85" />
                    <View
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="5dp"
                        android:background="#FFD400"
                        android:alpha="0.75" />
                    <View
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="5dp"
                        android:background="#F5F7FA"
                        android:alpha="0.7" />
                    <View
                        android:layout_width="16dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="12dp"
                        android:background="#FFD400"
                        android:alpha="0.9" />
                </LinearLayout>

                <!-- Logo Orb with Glow -->
                <View
                    android:id="@+id/logoGlow"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_marginTop="70dp"
                    android:background="@drawable/logo_glow_halo"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/logoOrb"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_marginTop="80dp"
                    android:background="@drawable/logo_ring_premium"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Title -->
                <TextView
                    android:id="@+id/titleMikaze"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="MIKAZE"
                    android:textAllCaps="true"
                    android:textColor="#FFD400"
                    android:textSize="56sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    app:layout_constraintTop_toBottomOf="@id/logoOrb"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/subTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ANDROID CONTROL PANEL"
                    android:textAllCaps="true"
                    android:textColor="#F2D844"
                    android:textSize="16sp"
                    android:letterSpacing="0.12"
                    app:layout_constraintTop_toBottomOf="@id/titleMikaze"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- License Card -->
                <LinearLayout
                    android:id="@+id/licenseCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/panel_card_premium"
                    android:orientation="vertical"
                    android:padding="14dp"
                    app:layout_constraintTop_toBottomOf="@id/subTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LICENSE KEY"
                        android:textAllCaps="true"
                        android:textColor="#FFD400"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/licenseHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Enter MIKAZE key to unlock."
                        android:textColor="#D8D9DB"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/licenseInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/input_premium_bg"
                        android:hint="Key..."
                        android:textColorHint="#7A7E85"
                        android:textColor="#F8F9FA"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/verifyButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/button_gold_premium"
                        android:text="VERIFY"
                        android:textColor="#0A0C10"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/connectionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Status: Awaiting Key"
                        android:textColor="#A6A8AC"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="v1.0.0"
                    android:textColor="#FFD400"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Main Control Panel -->
        <androidx.cardview.widget.CardView
            android:id="@+id/panelCard"
            android:layout_width="640dp"
            android:layout_height="700dp"
            app:cardCornerRadius="36dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#050609">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/console_panel_premium"
                android:padding="20dp">

                <!-- Header -->
                <TextView
                    android:id="@+id/mainTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="18dp"
                    android:text="MIKAZE"
                    android:textColor="#FFD400"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/mainClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="20dp"
                    android:text="22:37"
                    android:textColor="#F8F9FA"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/desktopSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="18dp"
                    android:text="CONTROL SYSTEM"
                    android:textColor="#FFD400"
                    android:textSize="20sp"
                    android:letterSpacing="0.1"
                    app:layout_constraintTop_toBottomOf="@id/mainTitle"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Main Menu Container -->
                <ScrollView
                    android:id="@+id/panelScroll"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="22dp"
                    app:layout_constraintTop_toBottomOf="@id/desktopSubtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/closeMenuButton">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- DISPLAY SECTION -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/section_container_bg"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="► DISPLAY"
                                android:textColor="#FFD400"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="8dp"
                                android:background="#FFD400"
                                android:alpha="0.5" />

                            <!-- Show FPS -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:background="@drawable/dot_indicator_gold"
                                    android:alpha="0.8" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="Show FPS Counter"
                                    android:textColor="#F0F2F5"
                                    android:textSize="16sp" />

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switchFps"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:thumbTint="#FFD400"
                                    android:trackTint="#3A3A3A" />

                                <TextView
                                    android:id="@+id/fpsState"
                                    android:layout_width="40dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:gravity="center"
                                    android:text="ON"
                                    android:textColor="#FFD400"
                                    android:textStyle="bold"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Show Timer -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:background="@drawable/dot_indicator_gold"
                                    android:alpha="0.8" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="Show Session Timer"
                                    android:textColor="#F0F2F5"
                                    android:textSize="16sp" />

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switchTimer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:thumbTint="#FFD400"
                                    android:trackTint="#3A3A3A" />

                                <TextView
                                    android:id="@+id/timerState"
                                    android:layout_width="40dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:gravity="center"
                                    android:text="ON"
                                    android:textColor="#FFD400"
                                    android:textStyle="bold"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Show Clock -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:background="@drawable/dot_indicator_gold"
                                    android:alpha="0.8" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="Show System Clock"
                                    android:textColor="#F0F2F5"
                                    android:textSize="16sp" />

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switchClock"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="false"
                                    android:thumbTint="#CFCFCF"
                                    android:trackTint="#3A3A3A" />

                                <TextView
                                    android:id="@+id/clockState"
                                    android:layout_width="40dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:gravity="center"
                                    android:text="OFF"
                                    android:textColor="#CFCFCF"
                                    android:textStyle="bold"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- PERFORMANCE SECTION -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/section_container_bg"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="► PERFORMANCE"
                                android:textColor="#FFD400"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="8dp"
                                android:background="#FFD400"
                                android:alpha="0.5" />

                            <!-- Dark Mode -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:background="@drawable/dot_indicator_gold"
                                    android:alpha="0.8" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="Dark Mode Optimization"
                                    android:textColor="#F0F2F5"
                                    android:textSize="16sp" />

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switchDarkMode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:thumbTint="#FFD400"
                                    android:trackTint="#3A3A3A" />

                                <TextView
                                    android:id="@+id/darkModeState"
                                    android:layout_width="40dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:gravity="center"
                                    android:text="ON"
                                    android:textColor="#FFD400"
                                    android:textStyle="bold"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Turbo Mode -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:background="@drawable/dot_indicator_gold"
                                    android:alpha="0.8" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="Turbo Mode (Experimental)"
                                    android:textColor="#F0F2F5"
                                    android:textSize="16sp" />

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switchPerformance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="false"
                                    android:thumbTint="#CFCFCF"
                                    android:trackTint="#3A3A3A" />

                                <TextView
                                    android:id="@+id/performanceState"
                                    android:layout_width="50dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:gravity="center"
                                    android:text="NORMAL"
                                    android:textColor="#CFCFCF"
                                    android:textStyle="bold"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Graphics Quality -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:background="@drawable/dot_indicator_gold"
                                    android:alpha="0.8" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="Graphics Settings"
                                    android:textColor="#F0F2F5"
                                    android:textSize="16sp" />

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switchGfx"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="false"
                                    android:thumbTint="#CFCFCF"
                                    android:trackTint="#3A3A3A" />

                                <TextView
                                    android:id="@+id/gfxState"
                                    android:layout_width="50dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:gravity="center"
                                    android:text="HIGH"
                                    android:textColor="#CFCFCF"
                                    android:textStyle="bold"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- NOTIFICATIONS SECTION -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/section_container_bg"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="► NOTIFICATIONS"
                                android:textColor="#FFD400"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="8dp"
                                android:background="#FFD400"
                                android:alpha="0.5" />

                            <!-- Notifications -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:background="@drawable/dot_indicator_gold"
                                    android:alpha="0.8" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="Panel Notifications"
                                    android:textColor="#F0F2F5"
                                    android:textSize="16sp" />

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switchNotifications"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:thumbTint="#FFD400"
                                    android:trackTint="#3A3A3A" />

                                <TextView
                                    android:id="@+id/notifState"
                                    android:layout_width="40dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:gravity="center"
                                    android:text="ON"
                                    android:textColor="#FFD400"
                                    android:textStyle="bold"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Advanced -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:background="@drawable/dot_indicator_gold"
                                    android:alpha="0.8" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="Advanced Analytics"
                                    android:textColor="#F0F2F5"
                                    android:textSize="16sp" />

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switchAdvanced"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="false"
                                    android:thumbTint="#CFCFCF"
                                    android:trackTint="#3A3A3A" />

                                <TextView
                                    android:id="@+id/advancedState"
                                    android:layout_width="40dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:gravity="center"
                                    android:text="OFF"
                                    android:textColor="#CFCFCF"
                                    android:textStyle="bold"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <!-- Status Indicator -->
                <LinearLayout
                    android:id="@+id/statusIndicator"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/status_bar_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    app:layout_constraintBottom_toTopOf="@id/closeMenuButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#FFD400"
                        android:alpha="0.8" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="System Status: ONLINE"
                        android:textColor="#FFD400"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ ACTIVE"
                        android:textColor="#FFD400"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Menu Button -->
                <Button
                    android:id="@+id/closeMenuButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_action_premium"
                    android:text="CLOSE MENU"
                    android:textColor="#FFD400"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Closed Badge -->
                <LinearLayout
                    android:id="@+id/menuClosedBadge"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="#050609"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@id/desktopSubtitle"
                    app:layout_constraintBottom_toTopOf="@id/closeMenuButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MENU CLOSED"
                        android:textColor="#FFD400"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:alpha="0.7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Click button to open"
                        android:textColor="#A6A8AC"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Control Panel Container -->
                <LinearLayout
                    android:id="@+id/panelContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/desktopSubtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
